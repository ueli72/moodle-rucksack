{{!
    local/rucksack/templates/badge_row.mustache
    ----------------------------------------------------------------
    Partial template for a single badge row.
    It is rendered inline inside the main earned_badges.mustache template
    for both the screen view and the PDF output.

    Data context (passed from the main template or earned_badges renderable):
    - badgeurl      URL of the badge image
    - badgename     Name of the badge
    - description   Formatted badge description (may contain HTML, hence unescaped)
    - dateissued    Unix timestamp when the badge was issued

    Note: the description variable is rendered with triple Mustache braces
    so that the formatted HTML (line breaks, lists) is output unescaped.
}}
<div class="local-rucksack-badge-row">
    {{! Badge name on the first line, full width }}
    <h4 class="local-rucksack-badge-name">{{badgename}}</h4>

    {{! Second line: badge image on the left, description + date on the right }}
    <div class="local-rucksack-badge-body">
        <div class="local-rucksack-badge-image">
            <img src="{{badgeurl}}" alt="{{badgename}}" class="local-rucksack-badge-img">
        </div>
        <div class="local-rucksack-badge-content">
            {{! Badge description: may contain HTML from local_rucksack_format_description() }}
            <div class="local-rucksack-badge-description">{{{description}}}</div>

            {{! Award date, positioned at the bottom-right via CSS }}
            {{#dateissued}}
            <p class="local-rucksack-badge-date">{{#str}}dateissued, local_rucksack{{/str}} {{#userdate}} {{dateissued}}, %d.%m.%Y {{/userdate}}</p>
            {{/dateissued}}
        </div>
    </div>
</div>
