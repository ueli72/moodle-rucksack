<div class="local-rucksack-container">
    <header class="local-rucksack-header">
        <h1>{{#str}}badgesfor, local_rucksack{{/str}} {{username}}</h1>
        <p class="local-rucksack-meta">{{#str}}issuedon, local_rucksack{{/str}} {{date}}</p>
    </header>

    {{#nodata}}
    <p class="local-rucksack-empty">{{#str}}nobadges, local_rucksack{{/str}}</p>
    {{/nodata}}

    {{^nodata}}
    <div class="local-rucksack-tree">
        {{#plans}}
        <div class="local-rucksack-framework">
            <h2 class="local-rucksack-framework-title">{{plan}}</h2>

            {{#planbadges.0}}
            <table class="local-rucksack-badge-table">
                {{#planbadges}}
                <tr>
                    <td class="local-rucksack-badge-table-cell">{{> local_rucksack/badge_cell}}</td>
                </tr>
                {{/planbadges}}
            </table>
            {{/planbadges.0}}

            {{#sections.0}}
            {{#sections}}
            <div class="local-rucksack-competency level-{{level}}">
                {{#haschildren}}
                <h3 class="local-rucksack-competency-title">{{name}}</h3>
                {{/haschildren}}
                {{^haschildren}}
                {{^hidetitle}}
                <h3 class="local-rucksack-competency-title">{{name}}</h3>
                {{/hidetitle}}
                {{/haschildren}}

                {{#hasbadges}}
                <table class="local-rucksack-badge-table">
                    {{#badgerows}}
                    <tr>
                        {{#.}}
                        <td class="local-rucksack-badge-table-cell">{{> local_rucksack/badge_cell}}</td>
                        {{/.}}
                    </tr>
                    {{/badgerows}}
                </table>
                {{/hasbadges}}
            </div>
            {{/sections}}
            {{/sections.0}}
        </div>
        {{/plans}}
    </div>
    {{/nodata}}
</div>
